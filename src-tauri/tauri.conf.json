{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swallpaper Windows",
  "version": "0.1.0",
  "identifier": "com.swallpaper.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Swallpaper Windows",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Utility",
    "shortDescription": "Windows wallpaper engine for Swallpaper",
    "longDescription": "A Windows wallpaper engine prototype for Swallpaper, built with Tauri, Rust, and React."
  }
}
